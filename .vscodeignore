packages/**
# Exclude sources, configs, tooling, and the CLI package from the vsix.
# The shipped CLI is pre-bundled under resources/ — no runtime node_modules needed.
.gitignore
.vscodeignore
.markdownlint.jsonc
.editorconfig
.npmrc
plan.md
*.code-workspace
pnpm-lock.yaml
pnpm-workspace.yaml
.claude/**
tsconfig.json
tsconfig.base.json
tsup.config.ts
vitest.config.ts
eslint.config.js
src/**
tests/**
build-scripts/**
node_modules/**
.git/**
.vscode/**
.github/**
docs/**
assets/**
packages/**
# exception: the extension/view icons live in the CLI package (single source)
!assets/images/git-co-author-enhanced.png
!assets/images/git-co-author-enhanced-outline.png
**/*.ts
**/*.map
