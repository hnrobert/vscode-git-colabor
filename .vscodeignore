# Exclude sources, configs, tooling, and the CLI submodule from the vsix.
# The shipped CLI is pre-bundled under resources/ — no runtime node_modules needed.
.gitignore
.gitmodules
.vscodeignore
.markdownlint.jsonc
.editorconfig
.npmrc
plan.md
*.code-workspace
pnpm-lock.yaml
pnpm-workspace.yaml
.claude/**
tsconfig.json
tsconfig.base.json
tsup.config.ts
vitest.config.ts
eslint.config.js
src/**
tests/**
build-scripts/**
node_modules/**
.git/**
.vscode/**
git-colabor/**
# exception: the extension/view icon lives in the submodule (single source)
!git-colabor/assets/images/git-co-author-enhanced-outline.png
**/*.ts
**/*.map
