{
  "name": "vscode-git-colabor",
  "displayName": "Git Colabor",
  "publisher": "HNRobert",
  "version": "0.1.5",
  "description": "Git co-author + multi-identity + SSH key management. Switch committer/pusher identity and SSH key per repo, with better co-authors managing experience.",
  "license": "Apache-2.0",
  "icon": "git-colabor/assets/images/git-co-author-enhanced.png",
  "type": "module",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "co-author",
    "ssh",
    "identity",
    "pair-programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hnrobert/vscode-git-colabor.git"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "main": "dist/extension.cjs",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.git"
  ],
  "contributes": {
    "configuration": {
      "title": "Git Colabor",
      "properties": {
        "gitColabor.user.name": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides repo `user.name` in the extension context — **always wins** over git config. If empty, the active identity's name is used."
        },
        "gitColabor.user.email": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides repo `user.email` in the extension context."
        },
        "gitColabor.defaultIdentity": {
          "type": "string",
          "default": "",
          "description": "Identity id to auto-activate when a repo opens and none is active."
        },
        "gitColabor.cliPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the CLI bundle (defaults to the bundled resources/cli.cjs)."
        },
        "gitColabor.autoApplyOnRepoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Apply default/active identity when a repo opens."
        },
        "gitColabor.conflictWarningStaleMinutes": {
          "type": "number",
          "description": "Advisory heldBy staleness threshold (minutes). Unset = a session lock never goes stale."
        },
        "gitColabor.githubFetch": {
          "type": "boolean",
          "default": true,
          "description": "Offer the GitHub user search in Add Identity (profile URL / @handle / email; hits api.github.com unauthenticated)."
        },
        "gitColabor.postCommitSolo": {
          "type": "boolean",
          "default": false,
          "description": "Clear selected co-authors after a commit (watches COMMIT_EDITMSG)."
        },
        "gitColabor.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warning",
            "error",
            "off"
          ],
          "default": "info",
          "description": "Output channel log level."
        },
        "gitColabor.coAuthorIdentities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Remembered identities as `\"Name <email>\"` entries (used as co-author candidates). Two layers only: user (cross-machine) and workspace (per repo) — the machine level is the identity store itself (~/.config/git-colabor/identities.json). Saved from the Identities group's right-click menu."
        }
      }
    },
    "commands": [
      {
        "command": "gitColabor.useIdentity",
        "title": "Use Identity…",
        "category": "Git Colabor",
        "icon": "$(pass-filled)"
      },
      {
        "command": "gitColabor._useIdentityEverywhere",
        "title": "Use for All Windows (write repo config)",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.addIdentity",
        "title": "Add Identity / Key",
        "category": "Git Colabor",
        "icon": "$(add)"
      },
      {
        "command": "gitColabor.removeIdentity",
        "title": "Remove Identity…",
        "category": "Git Colabor",
        "icon": "$(remove)"
      },
      {
        "command": "gitColabor.logoutIdentity",
        "title": "Logout Identity",
        "category": "Git Colabor",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "gitColabor.soloCoAuthors",
        "title": "Solo (clear co-authors)",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.revertRepo",
        "title": "Revert Repo Identity",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.showAudit",
        "title": "Show Audit Log",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.doctor",
        "title": "Doctor",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.reload",
        "title": "Reload",
        "category": "Git Colabor",
        "icon": "$(refresh)"
      },
      {
        "command": "gitColabor.openSettings",
        "title": "Open Settings",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._changeIdentityName",
        "title": "Change Identity Name…",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._changeIdentityEmail",
        "title": "Change Identity Email…",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._addIdentityKey",
        "title": "Add SSH Key for Identity…",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._changeIdentityKey",
        "title": "Change Identity Key…",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._signCommitsWithKey",
        "title": "Sign Commits with This Key",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._stopSigningCommits",
        "title": "Stop Signing Commits",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._loadKeyIntoAgent",
        "title": "Load Key into ssh-agent",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._removeKeyFromAgent",
        "title": "Unload Key from ssh-agent",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor.showHiddenIdentities",
        "title": "Show Hidden Identities…",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._rememberOnMachine",
        "title": "Remember on Machine",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._rememberOnUser",
        "title": "Remember in VS Code User Settings",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._forgetFromMachine",
        "title": "Forget from Machine",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._hideThisIdentity",
        "title": "Hide This Identity on This Machine",
        "category": "Git Colabor"
      },
      {
        "command": "gitColabor._forgetFromUser",
        "title": "Forget from VS Code User Settings",
        "category": "Git Colabor"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitColabor.identitiesView",
          "name": "Git Colabor: Identity & Co-authors",
          "icon": "git-colabor/assets/images/git-co-author-enhanced-outline.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitColabor.identitiesView",
        "contents": "No git repository in the current workspace.\n[Add Identity](command:gitColabor.addIdentity)",
        "when": "workbenchState == empty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitColabor.addIdentity",
          "when": "view == gitColabor.identitiesView",
          "group": "navigation@2"
        },
        {
          "command": "gitColabor.reload",
          "when": "view == gitColabor.identitiesView",
          "group": "navigation@3"
        },
        {
          "command": "gitColabor.openSettings",
          "when": "view == gitColabor.identitiesView",
          "group": "2_misc@1"
        },
        {
          "command": "gitColabor.showHiddenIdentities",
          "when": "view == gitColabor.identitiesView",
          "group": "3_hidden"
        }
      ],
      "view/item/context": [
        {
          "command": "gitColabor.useIdentity",
          "when": "viewItem =~ /^identity/",
          "group": "inline"
        },
        {
          "command": "gitColabor.logoutIdentity",
          "when": "viewItem =~ /^active-identity/",
          "group": "inline"
        },
        {
          "command": "gitColabor.removeIdentity",
          "when": "viewItem =~ /^(identity|active-identity)(?!.*-g)/",
          "group": "2_remove"
        },
        {
          "command": "gitColabor._addIdentityKey",
          "when": "viewItem =~ /^(identity|active-identity)(?!.*-k)/",
          "group": "3_key@1"
        },
        {
          "command": "gitColabor._changeIdentityKey",
          "when": "viewItem =~ /^(identity|active-identity)(?=.*-k)/",
          "group": "3_key@1"
        },
        {
          "command": "gitColabor._loadKeyIntoAgent",
          "when": "viewItem =~ /^(identity|active-identity)(?=.*-k)(?!.*-a)/",
          "group": "3_key@2"
        },
        {
          "command": "gitColabor._removeKeyFromAgent",
          "when": "viewItem =~ /-a/",
          "group": "3_key@3"
        },
        {
          "command": "gitColabor._signCommitsWithKey",
          "when": "viewItem =~ /^(identity|active-identity)(?=.*-k)(?!.*-s)/",
          "group": "3_key@4"
        },
        {
          "command": "gitColabor._stopSigningCommits",
          "when": "viewItem =~ /-s/",
          "group": "3_key@5"
        },
        {
          "command": "gitColabor._useIdentityEverywhere",
          "when": "viewItem =~ /^(identity|active-identity)/",
          "group": "0_apply@1"
        },
        {
          "command": "gitColabor._changeIdentityName",
          "when": "viewItem =~ /^(identity|active-identity)/",
          "group": "1_modify@1"
        },
        {
          "command": "gitColabor._changeIdentityEmail",
          "when": "viewItem =~ /^(identity|active-identity)/",
          "group": "1_modify@2"
        },
        {
          "command": "gitColabor._rememberOnUser",
          "when": "viewItem =~ /^(identity|active-identity)(?!.*-rv)/",
          "group": "8_remember@1"
        },
        {
          "command": "gitColabor._forgetFromUser",
          "when": "viewItem =~ /-rv/",
          "group": "8_remember@1"
        },
        {
          "command": "gitColabor._rememberOnMachine",
          "when": "viewItem =~ /^(identity|active-identity)(?!.*-rm)/",
          "group": "8_remember@2"
        },
        {
          "command": "gitColabor._forgetFromMachine",
          "when": "viewItem =~ /-rm/",
          "group": "8_remember@2"
        },
        {
          "command": "gitColabor._hideThisIdentity",
          "when": "viewItem =~ /^(identity|active-identity)/",
          "group": "9_hide"
        }
      ],
      "commandPalette": [
        {
          "command": "gitColabor._changeIdentityName",
          "when": "false"
        },
        {
          "command": "gitColabor._changeIdentityEmail",
          "when": "false"
        },
        {
          "command": "gitColabor._changeIdentityKey",
          "when": "false"
        },
        {
          "command": "gitColabor._signCommitsWithKey",
          "when": "false"
        },
        {
          "command": "gitColabor._stopSigningCommits",
          "when": "false"
        },
        {
          "command": "gitColabor._rememberOnMachine",
          "when": "false"
        },
        {
          "command": "gitColabor._rememberOnUser",
          "when": "false"
        },
        {
          "command": "gitColabor._forgetFromMachine",
          "when": "false"
        },
        {
          "command": "gitColabor._forgetFromUser",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build:cli": "pnpm -C git-colabor run build",
    "build": "pnpm run build:cli && tsup && node build-scripts/copy-cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.83.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.13.1"
}
